# =============================================================================
# Template de variáveis — copie para .env e ajuste valores locais
#   cp .env.example .env
# O arquivo .env NÃO deve ser commitado (já está no .gitignore).
#
# IMPORTANTE — duas portas do Postgres:
#   POSTGRES_PORT          → sempre 5432 (rede Docker / dentro do container)
#   POSTGRES_PUBLISHED_PORT → porta no Windows (ex.: 5433 se o 5432 já estiver em uso)
# =============================================================================

# --- PostgreSQL (container Docker "db") ---
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=app
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_PUBLISHED_PORT=5433

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PUBLISHED_PORT=6379
REDIS_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=dev
RABBITMQ_PASSWORD=dev

# --- WireMock ---
WIREMOCK_HOST=wiremock
WIREMOCK_PORT=8080

# --- Redpanda (compatível com clientes Kafka) ---
REDPANDA_HOST=redpanda
REDPANDA_KAFKA_PORT=9092
REDPANDA_KAFKA_EXTERNAL_PORT=19092
REDPANDA_SCHEMA_REGISTRY_PORT=8081
REDPANDA_ADMIN_PORT=9644

# --- URLs: use dentro do Dev Container (hosts = nome do serviço) ---
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
# --- URL: use no Windows (DBeaver, psql local) — porta publicada ---
DATABASE_URL_HOST=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PUBLISHED_PORT}/${POSTGRES_DB}

REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}
KAFKA_BOOTSTRAP_SERVERS=${REDPANDA_HOST}:${REDPANDA_KAFKA_PORT}
WIREMOCK_BASE_URL=http://${WIREMOCK_HOST}:${WIREMOCK_PORT}
